{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/_generated/**",
    "dist",
    ".cloudflare",
    ".wrangler",
    "Cargo.toml",
    "packages/cloudflare-api-site/src/components/ui/**",
    "packages/cloudflare-api-site/src/generated",
    "packages/cloudflare-api-site/src/lib/**",
    "packages/cloudflare-api-site/src/styles/globals.css"
  ]
}

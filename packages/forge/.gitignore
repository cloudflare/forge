# Tarballs that scripts/archive.mjs makes.
/dist

# Tarballs from npm pack.
*.tgz

# Dev dependencies, which build the plugin library.
/node_modules

# scripts/build.mjs generates the WIT's bindings, forge's library world as a
# component with its types, and the libraries.
/src/wit
/src/component
/plugin/component
/plugin/*.js
/plugin/*.d.ts
/plugin/*.wasm

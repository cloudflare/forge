package forge:plugin@0.4.0;

/// Runs a plugin to generate files from a capnstruct-encoded Forge binary buffer.
world plugin {
    /// A generated file: its path relative to the output directory, using
    /// `/` as a separator, and its content. A file with no content is not
    /// written.
    record file {
        path: string,
        content: list<u8>,
    }

    /// Generates every file for the forge, in a fresh instance. Called
    /// exactly once with the capnstruct `ForgeDoc` buffer.
    export generate: func(forge: list<u8>) -> result<list<file>, string>;
}

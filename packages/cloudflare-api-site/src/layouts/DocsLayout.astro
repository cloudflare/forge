---
/**
 * DocsLayout — three-column docs layout.
 *
 * Named slots for overrides (all optional, defaults render otherwise):
 *   header, sidebar, toc, page-title, content-footer
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import VersionSelect from "@/components/VersionSelect.astro";
import { Banner } from "@/components/ui/banner";
import { Sidebar, SidebarFilter } from "@/components/ui/sidebar";
import { TOC, MobileTOC } from "@/components/ui/toc";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { PageActions } from "@/components/ui/page-actions";
import { Badge } from "@/components/ui/badge";
import type { DocsPageProps } from "@cloudflare/nimbus-docs/types";
import { getVersionStatus, getVersionAlternates, withBase } from "@cloudflare/nimbus-docs/runtime";

// Previous/next pagination is not rendered, so pages do not pass `prevNext`.
type Props = Omit<DocsPageProps, "prevNext"> & {
  audience?: "human";
  /** Widens the content column for two-pane API reference pages. */
  wide?: boolean;
  /** Shows `description` under the title. When false it only feeds page metadata. */
  showDescription?: boolean;
};

const { title, description, sidebar, headings, breadcrumbs, mode = "doc", banner, head = [], noindex, markdownUrl, socialImage, lastUpdated, editUrl, draft, audience, collection, entryId, wide = false, showDescription = true } = Astro.props;

const isCustom = mode === "custom";

// `sidebar: false` / `tableOfContents: false` in frontmatter come through
// from the route as literal `false` (not coerced to `[]`). They drive
// per-column suppression — chrome, mobile dialog, header menu button.
const showSidebar = sidebar !== false;

// Versioning: per-page status drives the deprecation banner. Search is disabled
// (`search: false`), so no Pagefind indexing attributes are emitted.
const versionStatus = collection ? await getVersionStatus(collection) : null;
const versionAlternates = collection && entryId
  ? await getVersionAlternates(collection, entryId)
  : null;
const currentSiblingUrl = versionAlternates?.canonical?.url
  ? withBase(versionAlternates.canonical.url, import.meta.env.BASE_URL)
  : null;
const homeHref = withBase("/", import.meta.env.BASE_URL);

const hasHeader = Astro.slots.has("header");
const hasSidebar = Astro.slots.has("sidebar");
const hasToc = Astro.slots.has("toc");
const hasPageTitle = Astro.slots.has("page-title");
const hasContentFooter = Astro.slots.has("content-footer");
---

<BaseLayout title={title} description={description} noindex={noindex || draft} markdownUrl={markdownUrl} socialImage={socialImage} lastUpdated={lastUpdated} head={head} collection={collection} entryId={entryId}>
  <div class="flex flex-col min-h-screen">
    {hasHeader ? <slot name="header" /> : <Header showSidebar={showSidebar} />}

    {isCustom ? (
      <main id="main-content" tabindex="-1" class="flex-1">
        <slot />
      </main>
    ) : (
      <div class="flex-1 mx-auto w-full">
        <div class="flex">
          {showSidebar && (
            <aside id="desktop-sidebar" data-nb-desktop-sidebar class="hidden md:flex w-60 lg:w-(--nb-sidebar-width) shrink-0 border-r border-border bg-background sticky top-14 h-[calc(100vh-3.5rem)] flex-col overflow-y-auto overscroll-contain relative">
              {hasSidebar ? (
                <slot name="sidebar" />
              ) : (
                <nav data-nb-sidebar-nav class="px-4 pb-12 flex-1">
                  <div class="sb-filter-bar">
                    <SidebarFilter placeholder="Filter sidebar" />
                  </div>
                  <Sidebar items={sidebar} persist />
                </nav>
              )}
              <div class="pointer-events-none sticky bottom-0 h-8 bg-gradient-to-t from-base to-transparent" />
            </aside>
          )}

          {/* Sidebar state restore — pre-sets data attributes before the
              disclosure module loads so collapsed/scrolled state survives nav.
              The `aria-hidden` attribute keeps Astro from bundling this as a
              deferred module: it MUST stay inline to run before the disclosure
              mounts, else the first click sees stale state.
              Only emit when the sidebar is rendered; otherwise the script is
              dead code (the `desktop-sidebar` element doesn't exist). */}
          {showSidebar && (
          <script is:inline aria-hidden="true">
          (function () {
            function centerActive(sidebar, active) {
              const sr = sidebar.getBoundingClientRect();
              const ar = active.getBoundingClientRect();
              sidebar.scrollTop += ar.top - sr.top - sr.height / 2 + ar.height / 2;
            }

            function restore() {
              try {
                const sidebar = document.getElementById("desktop-sidebar");
                if (!sidebar) return;
                const content = sidebar.querySelector("[data-nb-sidebar]");
                if (!content) return;

                // Open groups are restored on every viewport: the mobile drawer
                // borrows this same tree. Scroll belongs to the desktop rail only.
                const raw = sessionStorage.getItem("sidebar-state");
                const state = raw ? JSON.parse(raw) : null;
                if (state && content.dataset.nbSidebarHash === state.hash && Array.isArray(state.open)) {
                  const groups = content.querySelectorAll("details");
                  for (let i = 0; i < groups.length; i++) {
                    if (typeof state.open[i] === "boolean") groups[i].open = state.open[i];
                  }
                }

                const active = content.querySelector("[aria-current='page']");
                for (let d = active && active.closest("details"); d && content.contains(d); d = d.parentElement.closest("details")) {
                  d.open = true;
                }

                if (!matchMedia("(min-width: 48rem)").matches) return;
                if (state && typeof state.scroll === "number") {
                  sidebar.scrollTop = state.scroll;
                  if (active) {
                    const sr = sidebar.getBoundingClientRect();
                    const ar = active.getBoundingClientRect();
                    if (ar.top < sr.top || ar.bottom > sr.bottom) centerActive(sidebar, active);
                  }
                } else if (active) {
                  centerActive(sidebar, active);
                }
              } catch (_) {}
            }

            restore();
          })();
          </script>
          )}

          <main id="main-content" tabindex="-1" class="flex-1 min-w-0">
            <div class="mx-auto max-w-(--nb-content-max) px-4 md:px-6 pt-6 pb-12" style={wide ? "--nb-content-max: var(--cf-content-wide-max)" : undefined}>
              {versionStatus?.isDeprecated && (
                <Banner
                  variant="caution"
                  content={
                    currentSiblingUrl
                      ? `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. The latest version of this page is at <a href="${currentSiblingUrl}">${currentSiblingUrl}</a>.`
                      : `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. See the <a href="${homeHref}">current docs</a> for up-to-date content.`
                  }
                />
              )}
              {banner && <Banner content={banner.content} variant={banner.type} dismissible={banner.dismissible} />}
              <Breadcrumbs items={breadcrumbs} class="pb-2" />
              <div>
                {hasPageTitle ? (
                  <slot name="page-title" />
                ) : (
                  <Fragment>
                    <div class="flex items-center gap-3 flex-wrap mt-6">
                      <h1 class="text-foreground mb-0 leading-tight [text-wrap:balance]" style={`font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)`}>{title}</h1>
                      {draft && <Badge text="Draft" variant="warning" size="medium" />}
                    </div>
                    {showDescription && description && (
                      <p class="text-[0.9375rem] sm:text-[1.0625rem] text-muted-foreground leading-relaxed mt-2 mb-2 [text-wrap:pretty]">{description}</p>
                    )}
                    <PageActions markdownUrl={markdownUrl} lastUpdated={lastUpdated} class={showDescription && description ? undefined : "mt-3"} />
                    {headings !== false && headings.length > 0 && (
                      <div class="border-border bg-background/95 supports-[backdrop-filter]:bg-background/80 sticky top-14 z-20 -mx-4 mt-3 border-y px-4 py-2 backdrop-blur md:-mx-6 md:px-6 xl:hidden">
                        <MobileTOC headings={headings} />
                      </div>
                    )}
                    {(markdownUrl || audience === "human") && (
                      audience === "human" ? (
                        <div class="mt-3 mb-6 flex items-center gap-3" role="none">
                          <div class="h-px flex-1 bg-border"></div>
                          <Badge text="For humans" variant="success" size="small" class="font-mono uppercase border border-success/15" />
                          <div class="h-px flex-1 bg-border"></div>
                        </div>
                      ) : (
                        <div class="mt-3 mb-6 h-px w-full bg-border" role="none" />
                      )
                    )}
                    {!(showDescription && description) && !markdownUrl && audience !== "human" && <div class="mb-4" />}
                  </Fragment>
                )}
                <article class="docs-content max-w-none">
                  <slot />
                </article>
                {hasContentFooter ? (
                  <slot name="content-footer" />
                ) : editUrl && (
                  <div class="mt-8 mb-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
                    <a href={editUrl} class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors no-underline" target="_blank" rel="noopener">
                      <Icon name="ph:pencil-simple" class="w-3.5 h-3.5" />
                      Edit this page
                    </a>
                  </div>
                )}
              </div>
            </div>
          </main>

          {headings !== false && (hasToc || headings.length > 0) && (
            <aside data-nb-toc-scroll-host class="hidden xl:block w-(--nb-toc-width) shrink-0 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto">
              <div class="pt-6 pb-8 pl-8 pr-6">
                {hasToc ? <slot name="toc" /> : <TOC headings={headings} />}
              </div>
            </aside>
          )}
        </div>
      </div>
    )}

  </div>

  {showSidebar && (
    /* Mobile sidebar — native <dialog> for free focus trap, escape, backdrop. */
    <dialog
      data-mobile-sidebar
      data-state="closed"
      class="group fixed inset-0 m-0 h-full w-full max-h-full max-w-full border-0 bg-transparent p-0 [&::backdrop]:bg-transparent"
      aria-label="Site navigation"
    >
      <div data-mobile-sidebar-panel class="h-full w-(--nb-sidebar-width) max-w-[85vw] -translate-x-full overflow-y-auto overscroll-contain border-r border-border bg-background transition-transform duration-250 ease-out group-data-[state=open]:translate-x-0 motion-reduce:transition-none">
        <div class="sticky top-0 z-20 flex items-center justify-between border-b border-border bg-background px-4 py-3">
          <span class="font-semibold text-sm text-foreground">Navigation</span>
          <button data-close-sidebar class="flex items-center justify-center w-8 h-8 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground transition-colors" aria-label="Close sidebar">
            <Icon name="ph:x" class="w-5 h-5" />
          </button>
        </div>
        {/* The desktop rail's <nav> moves here while the drawer is open, so the
            (very large) API tree is rendered once per page. */}
        {/* The header hides the version select on mobile; it lives here instead. */}
        <VersionSelect variant="drawer" />
        <div data-mobile-sidebar-nav></div>
      </div>
    </dialog>
  )}

  <script>
    import { mount, lockScroll, unlockScroll, generateId } from "@cloudflare/nimbus-docs/client";

    const CLOSE_DURATION_MS = 250;
    const DESKTOP_QUERY = "(min-width: 48rem)";

    // mount() binds the drawer once the document is ready.
    mount("[data-mobile-sidebar]", (root) => {
      const trigger = document.querySelector<HTMLElement>("[data-menu-btn]");
      if (!(root instanceof HTMLDialogElement) || !trigger) return () => {};
      const dialog = root;

      const controller = new AbortController();
      const { signal } = controller;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;

      const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!dialog.id) dialog.id = generateId("nb-mobile-sidebar");
      trigger.setAttribute("aria-controls", dialog.id);
      trigger.setAttribute("aria-expanded", "false");
      if (!trigger.hasAttribute("aria-haspopup")) trigger.setAttribute("aria-haspopup", "dialog");

      const clearTimer = () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // Borrow the desktop rail's <nav> while the drawer is open.
      const desktopRail = document.getElementById("desktop-sidebar");
      const navHost = dialog.querySelector<HTMLElement>("[data-mobile-sidebar-nav]");
      const nav = desktopRail?.querySelector<HTMLElement>("[data-nb-sidebar-nav]") ?? null;
      const railAnchor = nav?.nextSibling ?? null;
      const borrowNav = () => {
        if (!nav || !navHost || nav.parentElement === navHost) return;
        navHost.append(nav);
      };
      // Center the current page in the drawer; it must be laid out (open) first.
      const revealCurrent = () => {
        const panel = dialog.querySelector<HTMLElement>("[data-mobile-sidebar-panel]");
        const active = nav?.querySelector<HTMLElement>("[aria-current='page']");
        if (!panel || !active) return;
        const panelRect = panel.getBoundingClientRect();
        const activeRect = active.getBoundingClientRect();
        panel.scrollTop += activeRect.top - panelRect.top - panelRect.height / 2 + activeRect.height / 2;
      };
      const returnNav = () => {
        if (nav && desktopRail && nav.parentElement !== desktopRail) desktopRail.insertBefore(nav, railAnchor);
      };

      const openSidebar = () => {
        clearTimer();
        borrowNav();
        if (dialog.open) {
          // Reclaim a drawer caught mid-slide-out rather than stranding it open.
          if (dialog.dataset.state === "closing") dialog.dataset.state = "open";
          return;
        }

        dialog.showModal();
        revealCurrent();
        dialog.dataset.state = "closed";
        lockScroll();
        trigger.setAttribute("aria-expanded", "true");

        // Flush the closed transform, then open in the same tick so the slide
        // starts on the next frame (a double rAF delays it by two frames).
        void dialog.offsetWidth;
        dialog.dataset.state = "open";

        dialog.querySelector<HTMLElement>("[data-close-sidebar]")?.focus({ preventScroll: true });
      };

      // Immediate close (no slide-out): reduced motion, or the viewport reaching desktop.
      const closeNow = () => {
        if (!dialog.open) return;
        clearTimer();
        dialog.close();
      };

      const closeSidebar = () => {
        if (!dialog.open || dialog.dataset.state === "closing") return;
        if (prefersReducedMotion()) {
          closeNow();
          return;
        }
        dialog.dataset.state = "closing";
        closeTimer = setTimeout(() => dialog.close(), CLOSE_DURATION_MS);
      };

      trigger.addEventListener("click", openSidebar, { signal });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeSidebar();
      }, { signal });

      // Fires for Escape, close button, backdrop, and closeNow() — cleanup in one place.
      dialog.addEventListener("close", () => {
        clearTimer();
        returnNav();
        dialog.dataset.state = "closed";
        unlockScroll();
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      }, { signal });

      dialog.querySelectorAll<HTMLElement>("[data-close-sidebar]")
        .forEach((el) => el.addEventListener("click", closeSidebar, { signal }));

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) closeSidebar();
      }, { signal });

      // The hamburger is hidden past the desktop breakpoint; dismiss an open
      // drawer so it can't strand focus once its trigger disappears.
      const mql = window.matchMedia(DESKTOP_QUERY);
      mql.addEventListener("change", (event) => {
        if (event.matches) closeNow();
      }, { signal });
      if (mql.matches) closeNow();

      return () => {
        controller.abort();
        clearTimer();
        trigger.setAttribute("aria-expanded", "false");
        // A swap while open never fires `close`; balance the scroll lock.
        if (dialog.open) unlockScroll();
        returnNav();
      };
    });
  </script>

</BaseLayout>

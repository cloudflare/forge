---
/**
 * A command as the API pages show a request line: ApiEndpointCard without its
 * recessed method header. The same LayerCard parts and classes, so the strip is
 * the endpoint card's raised layer: 13px mono on a 24px line, as tall as the
 * card (42px), and the same copy button split off by a divider. What follows
 * the command (`[options]`) is shown muted and left out of the copy, so what's
 * pasted runs. A line too long for the strip scrolls under a fading edge.
 */
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import { LayerCard, LayerCardContent } from '@/components/ui/layer-card';

interface Props {
  command: string;
  /** What follows the command in its usage line. */
  tail?: string;
  label?: string;
}

const { command, tail, label = 'Copy command' } = Astro.props;
---

<LayerCard orientation="horizontal" dir="ltr">
  <LayerCardContent class="min-h-[2.625rem] flex-row items-stretch gap-0 p-0">
    <code class="command-line min-w-0 grow self-center overflow-x-auto px-3 font-mono text-[0.8125rem] leading-6 whitespace-pre text-foreground">{command}{tail && <span class="text-muted-foreground"> {tail}</span>}</code>
    <button
      type="button"
      data-cf-copy-command={command}
      aria-label={`${label}, ${command}`}
      title={label}
      class="group relative isolate flex shrink-0 cursor-pointer items-center justify-center overflow-hidden border-0 border-s border-border bg-inherit px-3 text-muted-foreground hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
    >
      <span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-all duration-200 group-data-[copied]:-translate-y-full group-data-[copied]:opacity-0">
        <Icon name="ph:copy" class="size-3.5" />
      </span>
      <span class="pointer-events-none absolute inset-0 flex translate-y-full items-center justify-center text-success opacity-0 transition-all duration-200 group-data-[copied]:translate-y-0 group-data-[copied]:opacity-100">
        <Icon name="ph:check" class="size-3.5" />
      </span>
      <span class="invisible size-3.5"></span>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </button>
  </LayerCardContent>
</LayerCard>

<style>
  .command-line {
    background: transparent;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent);
  }

  @media print {
    .command-line {
      white-space: pre-wrap;
      mask-image: none;
    }
  }
</style>

<script>
  import { mount } from '@cloudflare/nimbus-docs/client';
  import { copyOnClick } from './copy.client';

  mount('code.command-line + [data-cf-copy-command]', copyOnClick);
</script>

---
/**
 * A command's reference, as an operation page draws one: the endpoint it calls,
 * then its arguments and flags as field rows. The sections keep the ids they had
 * (`#arguments`, `#options`) so existing links still land.
 */
import { ApiFieldList } from '@/components/ui/api-field-row';
import type { CommandMetadata } from '../../command-reference/schema.ts';
import CommandEndpoint from './CommandEndpoint.astro';
import { argumentFields, flagFields } from './fields.ts';
import '@/components/ui/api-field-row/field-list.css';

interface Props {
  command: CommandMetadata;
}

const { command } = Astro.props;
const args = argumentFields(command);
const flags = flagFields(command);
---

<div class="command-reference">
  {command.apiPath && command.httpMethod && <CommandEndpoint method={command.httpMethod} path={command.apiPath} />}
  {args.length > 0 && <ApiFieldList as="h2" title="Arguments" anchor="arguments" fields={args} />}
  {flags.length > 0 && <ApiFieldList as="h2" title="Flags" anchor="options" fields={flags} />}
  {
    args.length === 0 && flags.length === 0 && (
      <section>
        <h2 id="options" class="fl-title mb-2">Flags</h2>
        <p class="command-reference-none">This command takes no arguments or flags.</p>
      </section>
    )
  }
</div>

<style>
  .command-reference {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  .command-reference-none {
    margin: 0;
    color: var(--nb-muted-foreground);
    font-size: 0.875rem;
  }
</style>

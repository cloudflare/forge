---
/**
 * The commands `cf` implements itself, as a cheat sheet: each group's title
 * over its rows, the command column as wide as the longest command so every
 * group lines up, each command with the first sentence of what it does.
 */
import type { CommandRouter } from '../../command-reference/routing.ts';
import type { CommandMetadata } from '../../command-reference/schema.ts';
import { commandTitle } from '../../command-reference/routing.ts';
import CommandRows from './CommandRows.astro';
import { summaryHtml } from './fields.ts';
import '@/components/ui/api-field-row/field-list.css';

interface Props {
  router: CommandRouter;
  commands?: readonly CommandMetadata[];
}

const { router, commands = router.commands } = Astro.props;
const { descriptions } = router;
const standalone = commands.filter((command) => command.fullPath.length === 1);
const grouped = new Map<string, CommandMetadata[]>();
for (const command of commands) {
  if (command.fullPath.length === 1) continue;
  const name = command.fullPath[0]!;
  grouped.set(name, [...(grouped.get(name) ?? []), command]);
}
const sections = [
  ...(standalone.length > 0 ? [{ id: 'command-list', title: 'Commands', description: undefined, commands: standalone }] : []),
  ...[...grouped].map(([name, groupCommands]) => {
    const title = commandTitle({ name });
    const description = descriptions[name];
    // A description that only repeats the group's name says nothing.
    return {
      id: `command-group-${name}`,
      title,
      description: description && description.trim().toLowerCase() !== title.toLowerCase() ? description : undefined,
      commands: groupCommands,
    };
  }),
];
// One command column for every group: the mono font advances 0.6em a character, at 0.8125rem.
const widest = Math.max(...commands.map((command) => command.command.length));
---

<div class="command-directory" style={`--command-width:${(widest * 0.6 * 0.8125).toFixed(3)}rem`}>
  {
    sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id} class="fl-title">
          {section.title}
          {section.description && <span>{section.description}</span>}
        </h2>
        <CommandRows
          rows={section.commands.map((command) => ({
            command: command.command,
            href: router.commandHref(command),
            html: summaryHtml(command.description),
          }))}
        />
      </section>
    ))
  }
</div>

<style>
  .command-directory {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  h2 {
    flex-wrap: wrap;
    column-gap: 0.625rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: calc(var(--nb-header-height, 3.5rem) + 1rem);
  }

  h2 span {
    color: var(--nb-muted-foreground);
    font-weight: 400;
  }
</style>

---
// From cloudflare-docs src/components/landing/FullPageLines.astro and src/components/decorative/Dots.astro (MIT).

const dashed =
  "background-image:linear-gradient(to bottom,var(--nb-border) 50%,transparent 50%);background-size:1px 32px;background-repeat:repeat-y";

const pad = "max(2rem, 4vw)";
---

<div class="pointer-events-none absolute inset-0 z-0 hidden lg:block" aria-hidden="true">
  <div class="absolute inset-y-0 left-1/2 w-full max-w-[1280px] -translate-x-1/2">
    <svg class="absolute inset-y-0 right-0 h-full" style={`width:${pad}`}>
      <pattern id="nb-dots" width="12" height="12" patternUnits="userSpaceOnUse">
        <circle cx="6" cy="6" r="0.75" fill="var(--nb-grid-line)"></circle>
      </pattern>
      <rect width="100%" height="100%" fill="url(#nb-dots)"></rect>
    </svg>
    <div class="absolute inset-y-0 w-px translate-x-1/2" style={`right:${pad};${dashed}`}></div>
    <div class="absolute inset-y-0 right-0 w-px translate-x-1/2" style={dashed}></div>
  </div>
</div>

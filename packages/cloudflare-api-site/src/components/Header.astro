---
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import { ThemeToggle } from './ui/theme-toggle';
import SiteTitle from './SiteTitle.astro';
import { VersionSwitcher } from './ui/version-switcher';
import { buttonClass } from './ui/button';

interface Props {
  /** Whether the page has a sidebar the mobile menu button can open. */
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;
---

<header class="site-header">
  <div class="site-header-bar">
    <div class="site-header-brand">
      <SiteTitle />
    </div>

    <div class="site-header-actions">
      <script is:inline>
        try {
          if (document.cookie.split(";").some((cookie) => cookie.trim() === "__cf_logged_in=1")) {
            document.currentScript?.parentElement?.classList.add("logged-in");
          }
        } catch {}
      </script>
      <VersionSwitcher apiCollection="api" />
      <a href="https://github.com/cloudflare/forge" class="site-header-github" aria-label="GitHub" target="_blank" rel="noopener">
        <Icon name="ph:github-logo" aria-hidden="true" />
      </a>
      <ThemeToggle />
      <div class="site-header-rule" role="separator"></div>
      <a href="https://dash.cloudflare.com/" class:list={[buttonClass("primary", "base"), "site-header-login"]}>
        <span data-auth="logged-out">Log in</span>
        <span data-auth="logged-in">Dashboard</span>
      </a>
      {
        showSidebar && (
          <button type="button" class="site-header-menu" aria-label="Open navigation" data-menu-btn>
            <Icon name="ph:list" aria-hidden="true" />
          </button>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    border-bottom: 1px solid var(--cf-border);
    background: color-mix(in oklch, var(--cf-card) 80%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .site-header-bar {
    --site-header-inset: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: var(--nb-header-height);
    padding-inline: var(--site-header-inset);
  }

  .site-header-brand {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .site-header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header-github {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    color: var(--cf-muted-foreground);
    transition: background-color 150ms;
  }

  .site-header-github:hover {
    background: var(--cf-accent);
  }

  .site-header-github:focus-visible {
    outline: 2px solid var(--nb-ring);
    outline-offset: 2px;
  }

  .site-header-github :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 40rem) {
    .site-header-github {
      display: inline-flex;
    }
  }

  .site-header-rule,
  .site-header-login {
    display: none;
  }

  .site-header-rule {
    flex-shrink: 0;
    width: 1px;
    height: 1rem;
    margin-inline: 0.375rem;
    background: var(--cf-border);
  }

  .site-header-login [data-auth='logged-in'],
  .logged-in .site-header-login [data-auth='logged-out'] {
    display: none;
  }

  .logged-in .site-header-login [data-auth='logged-in'] {
    display: inline;
  }

  .site-header-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.5rem;
    color: var(--cf-muted-foreground);
    background: transparent;
    cursor: pointer;
    transition:
      color 150ms,
      background-color 150ms;
  }

  .site-header-menu:hover {
    color: var(--cf-foreground);
    background: var(--cf-accent);
  }

  .site-header-menu :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  @media (min-width: 48rem) {
    .site-header-menu {
      display: none;
    }

    .site-header-rule {
      display: block;
    }

    .site-header-login {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .site-header-bar {
      --site-header-inset: 1.5rem;
    }
  }
</style>

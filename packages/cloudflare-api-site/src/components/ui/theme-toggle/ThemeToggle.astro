---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const { class: className, ...attrs } = Astro.props;
---

<button
  type="button"
  data-nb-theme-toggle
  class={cn(
    "flex items-center justify-center w-8 h-8 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors",
    className,
  )}
  {...attrs}
  aria-label="Toggle theme (light, dark, system)"
>
  <Icon name="ph:sun" class="nb-theme-ico nb-theme-ico-light h-[1.125rem] w-[1.125rem]" />
  <Icon name="ph:moon" class="nb-theme-ico nb-theme-ico-dark h-[1.125rem] w-[1.125rem]" />
  <Icon name="ph:monitor" class="nb-theme-ico nb-theme-ico-auto h-[1.125rem] w-[1.125rem]" />
</button>

<style is:global>
  .nb-theme-ico {
    display: none;
  }
  :root[data-nb-pref="light"] .nb-theme-ico-light,
  :root[data-nb-pref="dark"] .nb-theme-ico-dark,
  :root[data-nb-pref="auto"] .nb-theme-ico-auto,
  :root:not([data-nb-pref]) .nb-theme-ico-auto {
    display: block;
  }
</style>

<script>
  import "./theme-toggle.client";
</script>

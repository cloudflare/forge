---
/** The header's developer-resource links, for the phone menu, which opens only
 *  below the width where the header shows them. */
import { siteLinks } from '../site-links.ts';
---

<nav class="site-links" aria-label="Cloudflare developer resources">
  {
    siteLinks.map((link) => (
      <a href={link.href} aria-current={link.active ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  .site-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--cf-border);
    padding: 0.5rem 0.75rem;
  }

  .site-links a {
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
    color: var(--cf-muted-foreground);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.25rem;
    text-decoration: none;
  }

  .site-links a:hover,
  .site-links a[aria-current='page'] {
    color: var(--cf-foreground);
    background: var(--cf-accent);
  }
</style>

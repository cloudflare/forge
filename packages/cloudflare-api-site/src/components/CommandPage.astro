---
/**
 * A command page: DocsLayout around the content, with the API sidebar in its
 * sidebar slot, opened at `href` (the API overview, or a product's section).
 */
import DocsLayout from '@/layouts/DocsLayout.astro';
import ApiNavigation from '@/components/ApiNavigation.astro';
import { getApiNav } from '@cloudflare/nimbus-docs/runtime';

interface Props {
  title: string;
  description?: string;
  /** The API page whose sidebar the command shows, base-free (`/`, `/d1/`). */
  href: string;
}

const { title, description, href } = Astro.props;
const api = await getApiNav(Astro, { collection: 'api', href });
if (!api) throw new Error(`No API sidebar for ${href}`);
---

<DocsLayout title={title} description={description} sidebar={[]} headings={false} breadcrumbs={[]} showDescription={false}>
  {/* The mobile drawer borrows `[data-nb-sidebar-nav]` from the desktop rail. */}
  <div slot="sidebar" data-nb-sidebar-nav class="flex min-h-0 flex-1 flex-col">
    <ApiNavigation nav={api.nav} version={api.version} />
  </div>
  <slot />
</DocsLayout>

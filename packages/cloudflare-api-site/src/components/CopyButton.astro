---
interface Props {
  value: string;
  label?: string;
  copiedLabel?: string;
  errorLabel?: string;
  class?: string;
}

const {
  value,
  label = 'Copy to clipboard',
  copiedLabel = 'Copied to clipboard',
  errorLabel = 'Could not copy to clipboard',
  class: className,
} = Astro.props;
---

<copy-to-clipboard
  class:list={['copy-button', className]}
  data-copy-value={JSON.stringify(value)}
  data-copied-label={copiedLabel}
  data-error-label={errorLabel}
>
  <button type="button" aria-label={label} title={label}>
    <svg class="copy-icon" aria-hidden="true" viewBox="0 0 24 24">
      <rect width="13" height="13" x="9" y="9" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="m5 12 4 4L19 6"></path>
    </svg>
    <svg class="error-icon" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
  <span class="copy-status" data-copy-status aria-live="polite"></span>
</copy-to-clipboard>

<script>
  class CopyToClipboard extends HTMLElement {
    #attempt = 0;
    #button: HTMLButtonElement | undefined;
    #label = 'Copy to clipboard';
    #resetTimer: number | undefined;
    #status: Element | undefined;

    connectedCallback() {
      const button = this.querySelector('button');
      if (!(button instanceof HTMLButtonElement)) return;
      this.#button = button;
      this.#status = this.querySelector('[data-copy-status]') ?? undefined;
      this.#label = button.getAttribute('aria-label') ?? 'Copy to clipboard';
      this.#reset();
      button.addEventListener('click', this.#copy);
    }

    disconnectedCallback() {
      this.#attempt += 1;
      window.clearTimeout(this.#resetTimer);
      this.#button?.removeEventListener('click', this.#copy);
      this.#reset();
    }

    #copy = async () => {
      const serializedValue = this.dataset.copyValue;
      if (serializedValue === undefined) return;
      const value = JSON.parse(serializedValue) as unknown;
      if (typeof value !== 'string') return;

      const attempt = ++this.#attempt;
      let result = this.dataset.copiedLabel ?? 'Copied to clipboard';
      let state = 'copied';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        result = this.dataset.errorLabel ?? 'Could not copy to clipboard';
        state = 'error';
      }
      if (attempt !== this.#attempt || !this.isConnected || !this.#button) return;

      window.clearTimeout(this.#resetTimer);
      this.#button.dataset.copyState = state;
      this.#button.setAttribute('aria-label', result);
      this.#button.title = result;
      if (this.#status) this.#status.textContent = result;
      this.#resetTimer = window.setTimeout(() => this.#reset(), 1600);
    };

    #reset() {
      if (!this.#button) return;
      delete this.#button.dataset.copyState;
      this.#button.setAttribute('aria-label', this.#label);
      this.#button.title = this.#label;
      if (this.#status) this.#status.textContent = '';
    }
  }

  if (!customElements.get('copy-to-clipboard')) {
    customElements.define('copy-to-clipboard', CopyToClipboard);
  }
</script>

<style>
  copy-to-clipboard {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: var(--copy-button-width, var(--copy-button-size, 2.5rem));
    height: var(--copy-button-height, var(--copy-button-size, 2.5rem));
  }

  button {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    border: var(--copy-button-border, 1px solid var(--cf-border-strong));
    border-radius: var(--copy-button-radius, 0.375rem);
    padding: 0;
    color: var(--copy-button-color, var(--cf-muted-foreground));
    background: var(--copy-button-background, var(--cf-card));
    cursor: pointer;
  }

  button:hover {
    color: var(--copy-button-hover-color, var(--cf-foreground));
    background: var(--copy-button-hover-background, var(--cf-accent));
  }

  button:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--cf-ring);
    outline-offset: -2px;
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .check-icon,
  .error-icon,
  button[data-copy-state='copied'] .copy-icon {
    display: none;
  }

  button[data-copy-state='copied'] {
    color: var(--cf-success);
  }

  button[data-copy-state='copied'] .check-icon {
    display: block;
  }

  button[data-copy-state='error'] {
    color: var(--cf-danger);
  }

  button[data-copy-state='error'] .copy-icon {
    display: none;
  }

  button[data-copy-state='error'] .error-icon {
    display: block;
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media print {
    copy-to-clipboard {
      display: none;
    }
  }
</style>

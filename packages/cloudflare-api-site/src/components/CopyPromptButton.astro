---
// From cloudflare-docs src/components/CopyPromptButton.astro and src/scripts/copy-prompt.ts (MIT).
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { buttonClass } from "@/components/ui/button";

interface Props {
  prompt: string;
  title: string;
}

const { prompt, title } = Astro.props;

const AGENTS = ["claude", "codex", "cursor", "opencode"];
const icon = (id: string, mode: "light" | "dark") => withBase(`/icons/agents/${id}/${mode}.svg`, import.meta.env.BASE_URL);
---

<button type="button" class={`group/copy ${buttonClass("secondary")} cursor-copy!`} data-copy-prompt={prompt} title={title}>
  <span class="inline-flex items-center gap-2.5 text-base font-medium">
    <span class="relative flex h-5 shrink-0 items-center justify-start gap-[3px]" aria-hidden="true">
      {AGENTS.map((id) => (
        <>
          <img src={icon(id, "light")} alt="" class="block h-5 w-5 dark:hidden" loading="lazy" decoding="async" />
          <img src={icon(id, "dark")} alt="" class="hidden h-5 w-5 dark:block" loading="lazy" decoding="async" />
        </>
      ))}
    </span>
    <span class="group-data-[copied]/copy:hidden">Copy prompt</span>
    <span class="hidden group-data-[copied]/copy:inline">Prompt copied!</span>
  </span>
</button>
<span class="sr-only" aria-live="polite" data-copy-prompt-status></span>

<script>
  function init() {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]:not([data-ready])")) {
      button.dataset.ready = "";
      const status = button.nextElementSibling;
      let timer: number | undefined;
      button.addEventListener("click", async () => {
        window.clearTimeout(timer);
        try {
          await navigator.clipboard.writeText(button.dataset.copyPrompt ?? "");
        } catch {
          if (status) status.textContent = "Could not copy the prompt";
          return;
        }
        button.dataset.copied = "";
        if (status) status.textContent = "Prompt copied";
        timer = window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = "";
        }, 1500);
      });
    }
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>

---
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import CopyButton from './CopyButton.astro';
import { LayerCard, LayerCardContent, LayerCardHeader } from '@/components/ui/layer-card';

// No version numbers: written here by hand, they went stale.
const libraries = [
  {
    id: 'typescript',
    name: 'TypeScript',
    install: 'npm install cloudflare',
    icon: 'simple-icons:typescript',
  },
  {
    id: 'python',
    name: 'Python',
    install: 'pip install cloudflare',
    icon: 'simple-icons:python',
  },
  {
    id: 'go',
    name: 'Go',
    install: 'go get -u github.com/cloudflare/cloudflare-go/v7',
    icon: 'simple-icons:go',
  },
  {
    id: 'terraform',
    name: 'Terraform',
    install: 'cloudflare = { source = "cloudflare/cloudflare", version = "~> 5.0" }',
    icon: 'simple-icons:terraform',
  },
] as const;
---

<section class="pb-6" aria-labelledby="api-libraries-title">
  <div class="mb-6 lg:mb-8">
    <h2 id="api-libraries-title" class="text-foreground text-2xl leading-[1.1] font-medium text-balance md:text-3xl">Libraries</h2>
  </div>
  <div class="library-grid">
    {
      libraries.map((library) => (
        <LayerCard class="library-card" data-library={library.id}>
          <LayerCardHeader class="library-head">
            <span class="library-logo" aria-hidden="true">
              <Icon name={library.icon} />
            </span>
            <h3>{library.name}</h3>
          </LayerCardHeader>
          <LayerCardContent class="library-install-command">
            <code>{library.install}</code>
            <CopyButton
              class="library-copy-button"
              value={library.install}
              label={`Copy ${library.name} install command`}
              copiedLabel="Copied install command"
            />
          </LayerCardContent>
        </LayerCard>
      ))
    }
  </div>
</section>

<style>
  .library-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .library-grid > :global(.library-card) {
    min-width: 0;
  }

  .library-grid :global(.library-head) {
    gap: 0.5rem;
  }

  .library-logo {
    display: grid;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    place-items: center;
  }

  .library-logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  [data-library='typescript'] .library-logo {
    color: #3178c6;
  }

  [data-library='python'] .library-logo {
    color: #3776ab;
  }

  [data-library='go'] .library-logo {
    color: #00add8;
  }

  [data-library='terraform'] .library-logo {
    color: #7b42bc;
  }

  h3 {
    margin: 0;
    color: var(--cf-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .library-grid :global(.library-install-command) {
    flex-direction: row;
    align-items: stretch;
    gap: 0;
    padding: 0;
  }

  code {
    flex: 1;
    align-self: center;
    min-width: 0;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
    color: var(--cf-foreground);
    background: transparent;
    font-family: var(--nb-font-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    white-space: nowrap;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent);
  }

  .library-grid :global(.library-copy-button) {
    --copy-button-width: 2.5rem;
    --copy-button-height: 100%;
    --copy-button-border: 0;
    --copy-button-radius: 0;
    --copy-button-background: transparent;
    --copy-button-hover-background: var(--cf-accent);

    min-height: 2.25rem;
    border-inline-start: 1px solid var(--cf-border);
  }

  @media (max-width: 40rem) {
    .library-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .library-grid > :global(.library-card) {
      break-inside: avoid;
    }

    .library-grid :global(.library-copy-button) {
      display: none;
    }

    code {
      overflow: visible;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
      mask-image: none;
    }
  }
</style>

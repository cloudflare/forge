---
/** An operation's Terraform declarations, drawn with the API reference's own
 *  section heading and field rows. Each declaration is one list, like a
 *  request body: required attributes first, then optional, then read-only. */
import { terraformRolesSummary, type TerraformOperationData } from '../terraform.ts';
import TerraformFields, { type TerraformFlag } from './TerraformFields.astro';

interface Props {
  operation: TerraformOperationData;
}

const { operation } = Astro.props;
const kinds = { resource: 'Resource', 'data-source': 'Data source', 'list-data-source': 'List data source' };
const groups = [
  { key: 'required', flag: 'required' },
  { key: 'optional', flag: 'optional' },
  { key: 'computed', flag: 'read-only' },
] as const satisfies readonly { key: string; flag: TerraformFlag }[];
---

{
  operation.declarations.map((declaration, index) => (
    <section class="fl-root forge-terraform-declaration" data-api-section>
      <div class="fl-head">
        <h3 id={`terraform-${index + 1}`} class="fl-title scroll-mt-24">
          <span class="forge-terraform-kind">{kinds[declaration.kind]}</span>
          {/* Inside .nb-md one level down, so the name is a chip like the inline code in the descriptions. */}
          <span class="fl-desc nb-md forge-terraform-name">
            <span>
              <code>{declaration.name}</code>
            </span>
          </span>
        </h3>
      </div>
      <div class="fl-desc">{terraformRolesSummary(declaration)}</div>
      {declaration.descriptionHtml ? (
        <div class="fl-desc nb-md forge-terraform-summary" set:html={declaration.descriptionHtml} />
      ) : declaration.description ? (
        <div class="fl-desc forge-terraform-summary">
          <p>{declaration.description}</p>
        </div>
      ) : null}
      <div class="forge-terraform-fields">
        <TerraformFields
          fields={groups.flatMap((group) => declaration[group.key].map((field) => ({ field, flag: group.flag })))}
          anchor={`terraform-${index + 1}`}
        />
      </div>
    </section>
  ))
}

<style>
  .forge-terraform-declaration + .forge-terraform-declaration {
    margin-top: 2.5rem;
  }
  .forge-terraform-kind {
    color: var(--nb-muted-foreground);
    font-weight: 400;
  }
  .forge-terraform-name {
    margin: 0;
    font-weight: 400;
  }
  .forge-terraform-summary {
    margin-top: 0.5rem;
  }
  .forge-terraform-fields {
    margin-top: 1.25rem;
  }
</style>

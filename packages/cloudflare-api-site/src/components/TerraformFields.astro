---
/** Terraform attributes as the API reference's field rows (`ApiFieldRow`'s
 *  markup and `field-list.css`), so they read like the rest of the page. Each
 *  top-level row says whether the attribute is required, optional or read-only;
 *  nested attributes open from the row's `{ n attributes }` button. */
import type { TerraformAttribute } from '../terraform.ts';
import TerraformFields from './TerraformFields.astro';
import '@/components/ui/api-field-row/field-list.css';

export type TerraformFlag = 'required' | 'optional' | 'read-only';

interface Props {
  fields: { field: TerraformAttribute; flag?: TerraformFlag }[];
  /** Prefix of each row's anchor: the declaration's, then the parent's. */
  anchor: string;
  depth?: number;
}

const { fields, anchor, depth = 0 } = Astro.props;
const linkSvg = `<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
const count = (n: number) => `${n} ${n === 1 ? 'attribute' : 'attributes'}`;
---

<ul class:list={['fl-list', depth > 0 && 'fl-children']}>
  {
    fields.map(({ field, flag }) => {
      const id = `${anchor}-${field.name}`;
      const children = field.children ?? [];
      return (
        <li id={id} class:list={['fl-item', depth > 0 && 'fl-item--child']}>
          <div class="fl-row">
            <a href={`#${id}`} class="fl-anchor" aria-label={`Link to ${field.name}`} set:html={linkSvg} />
            <div class="fl-body">
              <div class="fl-sig">
                <div class:list={['fl-name', field.deprecated && 'fl-name--deprecated']}>{field.name}</div>
                {field.deprecated && <div class="fl-deprecated-badge">deprecated</div>}
                {(flag === 'optional' || flag === 'read-only') && <div class="fl-optional">{flag}</div>}
                <div class="fl-type-group">
                  <div class="fl-type">{field.type}</div>
                </div>
                {field.sensitive && <div class="fl-optional">sensitive</div>}
                {(flag === 'required' || children.length > 0) && (
                  <div class="fl-sig-tail">
                    {flag === 'required' && <div class="fl-required">required</div>}
                    {children.length > 0 && (
                      <button type="button" class="fl-count" data-fl-toggle aria-expanded="false">
                        <span class="fl-count-brace" aria-hidden="true">{'{'}</span>
                        <span class="fl-count-text">{count(children.length)}</span>
                        <span class="fl-count-brace" aria-hidden="true">{'}'}</span>
                      </button>
                    )}
                  </div>
                )}
              </div>
              {field.descriptionHtml ? (
                <div class="fl-desc" set:html={field.descriptionHtml} />
              ) : field.description ? (
                <div class="fl-desc">
                  <p>{field.description}</p>
                </div>
              ) : null}
              {field.deprecated && field.deprecated !== 'Deprecated.' && <div class="fl-constraints">{field.deprecated}</div>}
              {children.length > 0 && (
                <details class="fl-expandable">
                  <summary class="fl-expand-trigger" />
                  <TerraformFields fields={children.map((child) => ({ field: child }))} anchor={id} depth={depth + 1} />
                  <span class="fl-fold-close" aria-hidden="true">
                    {'}'}
                  </span>
                </details>
              )}
            </div>
          </div>
        </li>
      );
    })
  }
</ul>

<script>
  import '@/components/ui/api-field-row/api-field-row.client';
</script>

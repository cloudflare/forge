---
import { getApiPage, getApiRouter } from '../api-server.ts';

const router = await getApiRouter();
const resolved = await getApiPage(Astro.url, Astro.request, Astro.locals);
const page = resolved?.kind === 'operation' ? resolved.page : undefined;
const op = page?.operation;
const title =
  resolved?.kind === 'product'
    ? resolved.product.title
    : resolved?.kind === 'section'
      ? resolved.section.title
      : resolved?.kind === 'resource'
        ? resolved.resource.title
        : op?.title;
const breadcrumbs = resolved ? router.breadcrumbs(resolved) : [];
const markdownHref =
  resolved && page
    ? router.operationHref(
        page.product.id,
        page.snapshot.id,
        page.operation.operationId,
        'markdown',
        resolved.lang,
        page.operation.placement?.projectionId,
      )
    : undefined;
const availabilityLabels: Record<string, string> = {
  alpha: 'Alpha',
  beta: 'Beta',
  preview: 'Preview',
  'generally-available': 'Generally Available',
  deprecated: 'Deprecated',
  legacy: 'Legacy',
};
const availabilityStatus = op?.deprecated ? 'deprecated' : op?.availability?.status;
const availability = availabilityStatus
  ? (availabilityLabels[availabilityStatus] ?? availabilityStatus.replaceAll('-', ' '))
  : undefined;
---

{
  resolved && title ? (
    <div class="forge-operation-title">
      <div class="forge-title-meta">
        <nav aria-label="Breadcrumb">
          <ol>
            {breadcrumbs.map((breadcrumb) => (
              <li>
                {breadcrumb.href ? <a href={breadcrumb.href}>{breadcrumb.label}</a> : <span aria-current="page">{breadcrumb.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
        {markdownHref ? (
          <a class="forge-markdown-action" href={markdownHref}>
            View as Markdown
          </a>
        ) : null}
      </div>
      <div class="forge-heading-row">
        <h1 id="_top">{title}</h1>
        {
          op && availability ? (
            <span class="forge-availability-slot">
              <span class="forge-availability" data-status={availabilityStatus}>{availability}</span>
            </span>
          ) : null
        }
      </div>
      {op ? (
        <div class="forge-endpoint" aria-label={`${op.httpMethod} ${op.path}`}>
          <span class="forge-verb" data-verb={op.httpMethod}>{op.httpMethod}</span>
          <code title={op.path}>{op.path}</code>
        </div>
      ) : null}
    </div>
  ) : null
}

<style>
  .forge-operation-title {
    min-width: 0;
    padding-top: 0.5rem;
    padding-bottom: 1.75rem;
  }

  .forge-title-meta,
  .forge-heading-row,
  .forge-endpoint {
    display: flex;
    align-items: center;
  }

  .forge-title-meta {
    justify-content: space-between;
    gap: 1rem;
  }

  nav {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  ol {
    display: flex;
    align-items: center;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--cf-muted-foreground);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  li {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  li + li::before {
    content: '/';
    margin-inline: 0.5rem;
    color: var(--cf-border-strong);
  }

  nav a {
    color: inherit;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--cf-foreground);
  }

  .forge-markdown-action {
    flex: 0 0 auto;
    border: 1px solid var(--cf-border);
    border-radius: 0.375rem;
    padding: 0.4rem 0.625rem;
    color: var(--cf-muted-foreground);
    font-size: 0.75rem;
    font-weight: 550;
    line-height: 1;
    text-decoration: none;
  }

  .forge-markdown-action:hover {
    color: var(--cf-foreground);
    background: var(--cf-accent);
  }

  .forge-heading-row {
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  h1 {
    margin: 0;
    color: var(--cf-foreground);
    font-size: clamp(2rem, 5vw, 2.625rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .forge-availability {
    --forge-availability-color: var(--cf-muted-foreground);
    --forge-availability-background: var(--cf-muted);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.25rem;
    box-sizing: border-box;
    border: 1px solid color-mix(in oklch, var(--forge-availability-color) 25%, transparent);
    border-radius: 999px;
    padding: 0 0.5rem;
    color: var(--forge-availability-color);
    background: var(--forge-availability-background);
    font-size: 0.6875rem;
    font-weight: 650;
    line-height: 1;
    text-transform: capitalize;
  }

  .forge-availability-slot {
    display: flex;
    align-items: center;
    align-self: stretch;
  }

  .forge-availability[data-status='alpha'] {
    --forge-availability-color: color-mix(in oklch, var(--cf-info) 45%, var(--cf-danger));
    --forge-availability-background: color-mix(in oklch, var(--cf-info-muted) 45%, var(--cf-danger-muted));
  }

  .forge-availability[data-status='beta'] {
    --forge-availability-color: var(--cf-info);
    --forge-availability-background: var(--cf-info-muted);
  }

  .forge-availability[data-status='preview'] {
    --forge-availability-color: var(--cf-warning);
    --forge-availability-background: var(--cf-warning-muted);
  }

  .forge-availability[data-status='generally-available'] {
    --forge-availability-color: var(--cf-success);
    --forge-availability-background: var(--cf-success-muted);
  }

  .forge-availability[data-status='deprecated'] {
    --forge-availability-color: var(--cf-danger);
    --forge-availability-background: var(--cf-danger-muted);
  }

  .forge-endpoint {
    min-width: 0;
    gap: 0.625rem;
    margin-top: 1rem;
  }

  .forge-endpoint code {
    min-width: 0;
    overflow-x: auto;
    color: var(--cf-muted-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.8125rem;
    scrollbar-width: thin;
    white-space: nowrap;
  }

  .forge-verb {
    flex: 0 0 auto;
    border-radius: 0.3rem;
    padding: 0.25rem 0.45rem;
    color: var(--cf-muted-foreground);
    background: var(--cf-muted);
    font-family: var(--nb-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .forge-verb[data-verb='GET'] {
    color: var(--cf-success);
    background: var(--cf-success-muted);
  }

  .forge-verb[data-verb='POST'] {
    color: var(--cf-info);
    background: var(--cf-info-muted);
  }

  .forge-verb[data-verb='PUT'],
  .forge-verb[data-verb='PATCH'] {
    color: var(--cf-warning);
    background: var(--cf-warning-muted);
  }

  .forge-verb[data-verb='DELETE'] {
    color: var(--cf-danger);
    background: var(--cf-danger-muted);
  }

  @media (max-width: 39.99rem) {
    .forge-title-meta {
      align-items: stretch;
      flex-direction: column;
    }

    .forge-markdown-action {
      align-self: flex-start;
    }

    .forge-heading-row {
      margin-top: 1.25rem;
    }
  }
</style>

---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getDocsStaticPaths,
  getDocsPage,
  getRouteFlags,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
  stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../components";
import { getApiRouter } from "../api-server.ts";
import { getPageSidebar } from "../page-sidebar.ts";

// Nimbus's `rendering: { default: "request" }` turns this route into on-demand
// rendering; Nimbus requires canonical content routes to keep these exports.
export const prerender = true;
export const getStaticPaths = getDocsStaticPaths;

// The overview honours the site-wide `?version=` / `?lang=` selection; reject
// empty, duplicate, or unknown values like the API routes do.
const router = await getApiRouter();
if (router.isSitePath(Astro.url.pathname) && !router.resolveSiteSelection(Astro.url)) {
  return new Response("Not found", { status: 404 });
}

const page = await getDocsPage(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

// The rail is the API navigation for the selected version and target, shared
// with the API and tooling routes, rather than a tree of authored pages.
const sidebar = sidebarOn ? await getPageSidebar(Astro.url) : false;
// Pass `collection` so versioned pages (docs-<v>) get version-prefixed
// breadcrumb hrefs.
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ??
  await getLastUpdated(entry);
// `tocOn` already implies `tableOfContents !== false`, but TS can't carry
// that boolean narrowing to the value here — re-check it so `getTOC` only
// ever sees its options object (or undefined), never `false`.
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const socialImage = entry.data.socialImage ?? ogImageUrl;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>

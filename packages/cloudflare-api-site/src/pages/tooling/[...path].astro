---
import CommandPage from '../../components/CommandPage.astro';
import CommandLine from '../../components/commands/CommandLine.astro';
import CommandReference from '../../components/commands/CommandReference.astro';
import { commandBreadcrumbs } from '../../components/commands/command-page.ts';
import { proseHtml } from '../../components/commands/fields.ts';
import { commandProducts } from '../../command-sidebar.ts';
import { commandTitle } from '../../command-reference/routing.ts';
import { stripBase } from '@cloudflare/nimbus-docs/runtime';
import { getCommandRouter } from '../../command-reference/server.ts';
import { commandCard } from '../../og/card.ts';

const router = await getCommandRouter();
const command = router.resolve(Astro.url, commandProducts);
if (!command) return new Response('Not found', { status: 404 });
const markdownUrl = `${stripBase(Astro.url.pathname, import.meta.env.BASE_URL)}index.md`;
const product = commandProducts.find((item) => item.id === command.fullPath[0]);
---

<CommandPage
  title={commandTitle(command)}
  description={command.description}
  descriptionHtml={proseHtml(command.description)}
  breadcrumbs={commandBreadcrumbs(command, product)}
  href={product ? `/${product.slug}/` : '/'}
  markdownUrl={markdownUrl}
  ogCard={commandCard(commandTitle(command), command)}
>
  <CommandLine slot="request" command={command.command} tail={command.usage.slice(command.command.length).trim()} label="Copy command" />
  <CommandReference command={command} />
</CommandPage>

---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CommandReference from '../../components/commands/CommandReference.astro';
import { commandProducts, getCommandSidebar } from '../../command-sidebar.ts';
import { commandPath, commandTitle } from '../../command-reference/routing.ts';
import { getCommandRouter } from '../../command-reference/server.ts';
import type { CommandMetadata } from '../../command-reference/schema.ts';

export const prerender = true;

export async function getStaticPaths() {
  const router = await getCommandRouter();
  const productIds = new Set(commandProducts.map((product) => product.id));
  return router.commands
    .filter((command) => !productIds.has(command.fullPath[0]))
    .map((command) => ({ params: { path: commandPath(command) }, props: { command } }));
}

interface Props {
  command: CommandMetadata;
}

const { command } = Astro.props;
const sidebar = await getCommandSidebar(Astro.url);
---

<DocsLayout
  title={commandTitle(command)}
  description={command.description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[]}
  showDescription={false}
>
  <CommandReference command={command} />
</DocsLayout>

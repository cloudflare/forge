---
import CommandPage from '../../components/CommandPage.astro';
import CommandReference from '../../components/commands/CommandReference.astro';
import { commandProducts } from '../../command-sidebar.ts';
import { commandTitle } from '../../command-reference/routing.ts';
import { getCommandRouter } from '../../command-reference/server.ts';

const router = await getCommandRouter();
const command = router.resolve(Astro.url, commandProducts);
if (!command) return new Response('Not found', { status: 404 });
---

<CommandPage title={commandTitle(command)} description={command.description} href="/">
  <CommandReference command={command} />
</CommandPage>

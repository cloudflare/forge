---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CommandDirectory from '../../components/commands/CommandDirectory.astro';
import CopyableCommand from '../../components/commands/CopyableCommand.astro';
import { commandProducts, getCommandSidebar } from '../../command-sidebar.ts';
import { getCommandRouter } from '../../command-reference/server.ts';

export const prerender = true;

const [router, sidebar] = await Promise.all([getCommandRouter(), getCommandSidebar(Astro.url)]);
const productIds = new Set(commandProducts.map((product) => product.id));
const commands = router.commands.filter((command) => !productIds.has(command.fullPath[0]));
---

<DocsLayout
  title="Developer Tooling"
  description="Reference for commands implemented directly by the cf CLI."
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[]}
  showDescription={false}
>
  <div class="command-overview">
    <CopyableCommand command="cf --help" label="Copy cf help command" />
    <CommandDirectory router={router} commands={commands} />
  </div>
</DocsLayout>

<style>
  .command-overview {
    display: grid;
    max-width: 58rem;
    gap: 2rem;
  }
</style>

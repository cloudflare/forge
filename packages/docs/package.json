{
  "name": "forge-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website for Forge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/forge",
    "directory": "packages/docs"
  },
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "start": "astro dev",
    "build": "cf build && nimbus-docs lint",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "astro": "astro",
    "deploy": "pnpm run build && cf deploy --prebuilt",
    "deploy:preview": "CLOUDFLARE_PREVIEW_BUILD=true pnpm run build && cf previews deploy --prebuilt"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^15.0.0-beta.2",
    "@astrojs/language-server": "2.17.3",
    "@cloudflare/nimbus-docs": "^0.20.1",
    "@emnapi/runtime": "1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "cf": "1.0.0-beta.27",
    "clsx": "^2.1.1",
    "pagefind": "^1.5.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",

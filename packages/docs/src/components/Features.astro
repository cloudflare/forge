---
/**
 * The landing page's feature grid: six claims, each backed by something in the code.
 *
 * Every cell is an icon, a title and a sentence. The claims are deliberately checkable -- each one
 * names the type, flag or file that makes it true -- because a code generator's docs are read by
 * people deciding whether to trust its output.
 */
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';

interface Feature {
	icon: string;
	title: string;
	body: string;
	href?: string;
}

const features: Feature[] = [
	{
		icon: 'ph:plugs-connected',
		title: 'Plugins all the way down',
		body: 'The TypeScript SDK and the MCP server are plugins. They implement the same two-method Plugin trait yours will, and get nothing yours does not.',
		href: '/plugins/overview/',
	},
	{
		icon: 'ph:tree-structure',
		title: 'One model, resolved once',
		body: 'Groups, methods, models and types, with every $ref followed, every null folded into a union, and every model placed in the group that uses it.',
		href: '/concepts/the-model/',
	},
	{
		icon: 'ph:file-ts',
		title: 'Write plugins in TypeScript',
		body: '@cloudflare/forge/plugin gives you a typed object graph and a printer that writes your imports. forge-plugin build compiles it to a 2 MB component.',
		href: '/plugins/typescript/',
	},
	{
		icon: 'ph:gear-six',
		title: 'Or in Rust',
		body: 'Implement forge::Plugin in-tree, or compile against the WIT with wit-bindgen for wasm32-wasip2 and ship it as a file.',
		href: '/plugins/rust/',
	},
	{
		icon: 'ph:shield-check',
		title: 'Sandboxed by construction',
		body: 'A WebAssembly plugin gets no files, network, environment or clock. It reads the model and returns files; the host checks every path before writing.',
		href: '/concepts/sandbox/',
	},
	{
		icon: 'ph:lightning',
		title: 'Fast, and parallel',
		body: 'A Rust core with arena-backed data. Groups generate concurrently, each wasm group in its own instance, and every error in the document is reported at once.',
		href: '/concepts/pipeline/',
	},
];
---

<div class="fg-features">
	{
		features.map((feature) => {
			const Tag = feature.href ? 'a' : 'div';
			return (
				<Tag class="fg-feature" href={feature.href}>
					<span class="fg-feature-icon">
						<Icon name={feature.icon} is:inline />
					</span>
					<h3 class="fg-feature-title">{feature.title}</h3>
					<p class="fg-feature-body">{feature.body}</p>
				</Tag>
			);
		})
	}
</div>

<style>
	.fg-features {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		margin: 1.5rem 0 2.5rem;
		border: 1px solid var(--nb-border-strong);
		border-radius: 0.75rem;
		overflow: hidden;
		/* The 1px gap shows this through as hairlines between the cells. */
		background: var(--nb-border-strong);
	}

	.fg-feature {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem 1.375rem 1.625rem;
		background: var(--nb-background);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	a.fg-feature:hover {
		background: var(--nb-card);
	}

	.fg-feature-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-bottom: 0.375rem;
		border-radius: 0.5rem;
		background: var(--fg-orange-wash);
		color: var(--fg-orange-text);
	}

	.fg-feature-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.docs-content .fg-feature-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--nb-foreground);
	}

	.docs-content .fg-feature-body {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--nb-muted-foreground);
	}

	@media (max-width: 56rem) {
		.fg-features {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 34rem) {
		.fg-features {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

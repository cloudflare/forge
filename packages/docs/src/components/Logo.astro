---
/**
 * The site's lockup: the Cloudflare cloud and the word "Forge".
 *
 * The cloud is Cloudflare's own mark, in its own two oranges, and is never recoloured -- the
 * same paths as `public/favicon.svg`. The word is live text in the site's sans at a heavy
 * weight, so it follows the scheme like any other heading and needs no generated artwork.
 *
 * `size` scales the whole lockup through `font-size`; everything inside is in `em`.
 */
interface Props {
	/** Font size of the word, which the cloud is sized against. */
	size?: string;
	class?: string;
}

const { size = '1.125rem', class: className } = Astro.props;
---

<span class:list={['fg-logo', className]} style={`--fg-logo-size: ${size}`}>
	<svg
		class="fg-logo-cloud"
		viewBox="0 0 66 30"
		fill="none"
		aria-hidden="true"
		focusable="false"
	>
		<path
			fill="#ff9910"
			d="M53.12 13.125c6.997 0 12.668 5.708 12.668 12.75 0 1.255-.18 2.468-.516 3.614a.72.72 0 0 1-.694.511H46.953a.375.375 0 0 1-.348-.51l.337-.882c1.076-2.833 4.146-5.154 6.987-5.29l5.384-.277a.543.543 0 0 0 .514-.544.543.543 0 0 0-.51-.544l-5.056-.299c-2.718-.14-4.046-2.56-3.315-5.081l.842-2.902a.72.72 0 0 1 .646-.527q.34-.02.686-.019"
		></path>
		<path
			fill="#ff5f08"
			d="M35.609 0c7.295 0 13.424 5.025 15.157 11.824.073.285.05.586-.054.862l-1.388 3.677c-1.076 2.833-3.842 5.29-6.97 5.29l-24.105.278a.533.533 0 0 0-.525.535c0 .293.234.531.524.535l23.765.316c2.724 0 4.046 2.56 3.316 5.081l-.307 1.061a.75.75 0 0 1-.716.541H.964a.71.71 0 0 1-.718-.646 11 11 0 0 1-.034-.854c0-5.476 4.166-9.973 9.482-10.456a7.2 7.2 0 0 1-.167-1.544c0-3.935 3.17-7.125 7.08-7.125 1.555 0 2.994.506 4.162 1.362C22.849 4.497 28.707 0 35.609 0"
		></path>
	</svg>
	<span class="fg-logo-word">Forge</span>
</span>

<style>
	.fg-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		font-size: var(--fg-logo-size);
		line-height: 1;
		color: var(--nb-foreground);
	}

	.fg-logo-cloud {
		width: 2.2em;
		height: 1em;
		flex-shrink: 0;
	}

	.fg-logo-word {
		font-weight: 700;
		letter-spacing: -0.02em;
	}
</style>

---
/**
 * A clean, hairline-divided list of links -- the landing's alternative to a
 * stack of filled cards. Transparent rows, one border around the group, an
 * immediate hover tint, and an arrow that nudges. Pairs with the bento above.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

interface Item {
  title: string;
  description?: string;
  href: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="fg-navlist">
  {
    items.map((item) => (
      <li>
        <a href={item.href} class="fg-navrow">
          <span class="fg-navrow-text">
            <span class="fg-navrow-title">{item.title}</span>
            {item.description && <span class="fg-navrow-desc">{item.description}</span>}
          </span>
          <Icon name="ph:arrow-right" class="fg-navrow-arrow" is:inline />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .fg-navlist {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  /* Separate outlined cards -- each owns its full border, so hover just
     lightens that border cleanly (no shared dividers or clipped rings). */
  .fg-navrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--nb-border);
    border-radius: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .fg-navrow:hover {
    border-color: color-mix(in oklch, var(--nb-foreground) 30%, transparent);
  }

  .fg-navrow-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .fg-navrow-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--nb-foreground);
  }
  .fg-navrow-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--nb-muted-foreground);
  }

  .fg-navrow-arrow {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--nb-muted-foreground);
    transition: transform 0.15s ease;
  }
  .fg-navrow:hover .fg-navrow-arrow {
    transform: translateX(2px);
  }
</style>

{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // No `baseUrl`: it is deprecated as of TypeScript 6 and `tsc` errors on it
    // outright (ts/5101). Since TypeScript 4.4 `paths` resolves relative to the
    // file it is declared in, so the alias works without it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}

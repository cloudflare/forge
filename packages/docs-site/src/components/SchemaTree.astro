---
import type { RenderedSchemaNodeSchema } from 'astro-fern/content';
import { fieldTypeLabel } from '../operation-sections.ts';
import SchemaTree from './SchemaTree.astro';

interface Props {
  nodes: RenderedSchemaNodeSchema[];
  /**
   * Request fields show required/optional (the caller supplies them). Response
   * fields only show "optional" for maybe-absent fields — a response field is
   * never something the caller "must" provide, so no "required" badge.
   */
  context?: 'request' | 'response';
}

const { nodes, context = 'request' } = Astro.props;

interface Expansion {
  label: string;
  nodes: RenderedSchemaNodeSchema[];
}

/** What (if anything) to reveal under a node: object props, union variants, or array-element structure. */
function expansionOf(n: RenderedSchemaNodeSchema): Expansion | null {
  if (n.children && n.children.length > 0) {
    return { label: `${n.children.length} ${n.children.length === 1 ? 'property' : 'properties'}`, nodes: n.children };
  }
  if (n.variants && n.variants.length > 0) {
    return { label: `${n.variants.length} ${n.variants.length === 1 ? 'variant' : 'variants'}`, nodes: n.variants };
  }
  const it = n.items;
  if (it?.children && it.children.length > 0) {
    return { label: `array — ${it.children.length} ${it.children.length === 1 ? 'property' : 'properties'}`, nodes: it.children };
  }
  if (it?.variants && it.variants.length > 0) {
    return { label: `array — ${it.variants.length} variants`, nodes: it.variants };
  }
  return null;
}

/** Requirement badge, context-aware. Responses never show "required". */
function requirement(n: RenderedSchemaNodeSchema): { text: string; cls: string } | null {
  if (!n.name) return null;
  if (context === 'response') return n.required ? null : { text: 'optional', cls: 'forge-optional' };
  return n.required ? { text: 'required', cls: 'forge-required' } : { text: 'optional', cls: 'forge-optional' };
}
---

<ul class="forge-fields">
  {
    nodes.map((n) => {
      const exp = expansionOf(n);
      const req = requirement(n);
      const typeText = fieldTypeLabel(n);
      return (
        <li class="forge-field">
          <div class="forge-field-head">
            {n.name ? <code>{n.name}</code> : null}
            {!n.name && n.title ? <span class="forge-variant-title">{n.title}</span> : null}
            {typeText ? <span class="forge-type">{typeText}</span> : null}
            {req ? <span class={req.cls}>{req.text}</span> : null}
            {n.deprecated ? <span class="forge-deprecated">deprecated</span> : null}
          </div>
          {n.enumValues && n.enumValueMetadata?.length ? (
            <div class="forge-enum-values">
              <span>Allowed values:</span>
              <ul>
                {n.enumValues.map((value) => {
                  const metadata = n.enumValueMetadata?.find((entry) => Object.is(entry.value, value));
                  return (
                    <li>
                      <div class="forge-enum-value">
                        <code>{String(value)}</code>
                        {metadata?.deprecated ? <span class="forge-deprecated">deprecated</span> : null}
                      </div>
                      {metadata?.description ? <div class="forge-enum-description" set:html={metadata.description.html} /> : null}
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : n.enumValues ? (
            <div class="forge-enum">
              Allowed values:{' '}
              {n.enumValues.map((value, index) => (
                <>
                  {index > 0 ? ', ' : null}
                  <code>{String(value)}</code>
                </>
              ))}
            </div>
          ) : null}
          {n.default !== undefined ? <div class="forge-default">Default: <code>{JSON.stringify(n.default)}</code></div> : null}
          {n.description ? <div class="forge-desc" set:html={n.description.html} /> : null}
          {exp ? (
            <details class="forge-nested">
              <summary>Show {exp.label}</summary>
              <SchemaTree nodes={exp.nodes} context={context} />
            </details>
          ) : null}
        </li>
      );
    })
  }
</ul>

<style>
  /*
   * Schema tree (params, request body, response fields). All selectors target
   * elements authored in this template, so scoping is safe. The one exception is
   * `.forge-desc`, whose body is injected via `set:html`: only its wrapper is
   * styled here; the injected block children are normalized in the global block
   * in `pages/api/[...slug].astro`.
   *
   * Colours use Starlight tokens; `--sl-color-text` (gray-2) is the accessible
   * body-text colour (gray-3 fails contrast on the dark background).
   */
  .forge-fields {
    margin: 0.75rem 0 0;
    list-style: none;
    padding-left: 0;
  }
  .forge-field + .forge-field {
    border-top: 1px solid var(--cf-border);
  }
  .forge-field {
    padding: 1rem 0;
  }
  .forge-field-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .forge-field-head code {
    padding: 0;
    color: var(--cf-foreground);
    background: transparent;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .forge-type {
    color: var(--cf-muted-foreground);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  .forge-variant-title {
    color: var(--cf-foreground);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .forge-required,
  .forge-optional,
  .forge-deprecated {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .forge-required {
    color: var(--cf-link);
  }
  .forge-optional {
    color: var(--cf-muted-foreground);
  }
  .forge-deprecated {
    color: var(--cf-danger);
  }
  .forge-enum,
  .forge-enum-values,
  .forge-default,
  .forge-desc {
    margin-top: 0.35rem;
    color: var(--cf-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .forge-enum code,
  .forge-enum-values code,
  .forge-default code {
    color: var(--cf-foreground);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  .forge-enum-values > ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .forge-enum-value {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .forge-enum-description :global(:first-child) {
    margin-top: 0.15rem;
  }
  .forge-enum-description :global(:last-child) {
    margin-bottom: 0;
  }
  .forge-nested {
    margin-top: 0.75rem;
    border-inline-start: 1px solid var(--cf-border);
    padding-inline-start: 1rem;
  }
  .forge-nested > summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    color: var(--cf-muted-foreground);
    font-size: 0.75rem;
    font-weight: 550;
  }
  .forge-nested > summary:hover {
    color: var(--cf-foreground);
  }
  .forge-nested > summary::before {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--cf-border);
    border-radius: 0.2rem;
    content: '+';
    font-family: var(--sl-font-mono);
    line-height: 1;
  }
  .forge-nested[open] > summary::before {
    content: '-';
  }
</style>

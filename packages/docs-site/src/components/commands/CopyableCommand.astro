---
import CopyButton from '../CopyButton.astro';

interface Props {
  command: string;
  label?: string;
}

const { command, label = 'Copy command' } = Astro.props;
---

<cf-copy-command>
  <span aria-hidden="true">$</span>
  <code title={command}>{command}</code>
  <CopyButton class="command-copy-button" value={command} label={label} copiedLabel="Copied command" />
</cf-copy-command>

<style>
  cf-copy-command {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 2.75rem;
    align-items: center;
    min-width: 0;
    min-height: 2.75rem;
    overflow: hidden;
    border: 1px solid var(--cf-border-strong);
    border-radius: 0.5rem;
    background: var(--cf-surface-sunken);
  }

  cf-copy-command > span {
    padding-inline-start: 0.875rem;
    color: var(--cf-primary);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    user-select: none;
  }

  code {
    overflow-x: auto;
    padding: 0.75rem 0.625rem;
    color: var(--cf-foreground);
    background: transparent;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    white-space: nowrap;
    scrollbar-width: thin;
  }

  cf-copy-command :global(.command-copy-button) {
    --copy-button-size: 2.75rem;
    --copy-button-border: 0;
    --copy-button-radius: 0;
    --copy-button-background: var(--cf-muted);
    --copy-button-hover-background: var(--cf-accent);

    border-inline-start: 1px solid var(--cf-border-strong);
  }

  @media print {
    cf-copy-command {
      grid-template-columns: auto minmax(0, 1fr);
    }

    code {
      overflow: visible;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }
  }
</style>

---
import logo from '../assets/cloudflare-logo.svg';
import { base } from 'astro:config/server';
import CloudflareWordmark from './CloudflareWordmark.astro';

const homeHref = base === '/' ? '/' : `${base.replace(/\/+$/, '')}/`;
const links = [
  { label: 'Directory', href: 'https://developers.cloudflare.com/directory/' },
  { label: 'API', href: homeHref, active: true },
  { label: 'SDKs', href: 'https://developers.cloudflare.com/fundamentals/api/reference/sdks/' },
  { label: 'Changelog', href: 'https://developers.cloudflare.com/changelog/' },
];
---

<div class="cloudflare-site-title">
  <a href={homeHref} aria-label="Cloudflare API" class="cloudflare-brand">
    <img src={logo.src} alt="" width="66" height="30" />
    <CloudflareWordmark role="img" aria-label="Cloudflare" class="cloudflare-wordmark" />
    <span class="cloudflare-product">API</span>
  </a>
  <nav aria-label="Cloudflare developer resources">
    {
      links.map((link) => (
        <a href={link.href} aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .cloudflare-site-title,
  .cloudflare-brand,
  nav {
    display: flex;
    align-items: center;
  }

  .cloudflare-site-title {
    min-width: 0;
    gap: 1rem;
  }

  .cloudflare-brand {
    flex: 0 0 auto;
    gap: 0.5rem;
    color: var(--cf-foreground);
    text-decoration: none;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cloudflare-brand:hover {
    color: var(--cf-primary);
  }

  .cloudflare-brand img {
    width: auto;
    height: 1.25rem;
  }

  .cloudflare-wordmark {
    display: none;
    width: auto;
    height: 0.6875rem;
  }

  .cloudflare-product {
    display: none;
    border: 1px solid var(--cf-border-strong);
    border-radius: 0.375rem;
    padding: 0.2rem 0.375rem;
    color: var(--cf-muted-foreground);
    font-size: 0.6875rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  nav {
    display: none;
    min-height: 1.75rem;
    gap: 0.25rem;
    border-inline-start: 1px solid var(--cf-border);
    padding-inline-start: 1rem;
  }

  nav a {
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    color: var(--cf-muted-foreground);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--cf-foreground);
    background: var(--cf-accent);
  }

  .cloudflare-brand:focus-visible,
  nav a:focus-visible {
    position: relative;
    z-index: 1;
    border-radius: 0.375rem;
  }

  @media (min-width: 40rem) {
    .cloudflare-wordmark,
    .cloudflare-product {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    nav {
      display: flex;
    }
  }
</style>

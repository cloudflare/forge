---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
---

<forge-sidebar-filter>
  <div class="sidebar-filter">
    <input
      data-sidebar-filter-input
      type="search"
      placeholder="Filter sidebar"
      aria-label="Filter navigation"
      autocomplete="off"
    />
    <kbd aria-hidden="true">/</kbd>
  </div>
  <DefaultSidebar />
</forge-sidebar-filter>

<script>
  import '../sidebar-filter.ts';
</script>

<style>
  forge-sidebar-filter {
    display: block;
  }

  .sidebar-filter {
    position: sticky;
    z-index: 1;
    top: 0;
    margin-bottom: 0.5rem;
    padding-block: 0.75rem;
    background: var(--cf-background);
  }

  input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.375rem 2.25rem 0.375rem 0.75rem;
    border: 1px solid var(--cf-border);
    border-radius: 0.375rem;
    color: var(--cf-foreground);
    background: var(--cf-card);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.25rem;
    transition: border-color 150ms;
  }

  input::placeholder {
    color: var(--cf-muted-foreground);
    opacity: 1;
  }

  input:not(:placeholder-shown) {
    padding-inline-end: 0.5rem;
  }

  input:focus-visible {
    border-color: var(--cf-primary);
    outline: 2px solid var(--cf-ring);
  }

  kbd {
    position: absolute;
    top: 50%;
    inset-inline-end: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.25rem;
    transform: translateY(-50%);
    border: 1px solid var(--cf-border);
    border-radius: 0.25rem;
    color: var(--cf-muted-foreground);
    background: var(--cf-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
    transition: opacity 150ms;
  }

  input:focus + kbd,
  input:not(:placeholder-shown) + kbd {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    kbd {
      transition: none;
    }
  }
</style>

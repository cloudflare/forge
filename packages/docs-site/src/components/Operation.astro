---
import { Aside } from '@/components/ui/aside';
import type { FernPageSchema } from 'astro-fern';
import { DEFER_THRESHOLD, nodeCount, operationView, responseSummary, topLevelNodes } from '../operation-sections.ts';
import CodeSample from './CodeSample.astro';
import SchemaSectionIsland from './SchemaSectionIsland.astro';
import SchemaTree from './SchemaTree.astro';

interface Props {
  page: FernPageSchema;
  selectedTarget?: string;
}

const { page, selectedTarget } = Astro.props;
const { operation: op } = page;
const view = operationView(op);
const responseNodes = topLevelNodes(view.response);
const returnsSummary = responseSummary(view.response, view.responseIsArray);
const showResponseSchemaSource =
  op.responses.length > 1 || (view.responseStatus?.representations.length ?? 0) > 1;
const requestMediaTypes = op.requestBody?.representations.map(({ mediaType }) => mediaType) ?? [];
const requestContentTypeLabel = requestMediaTypes.length === 1 ? 'Content type' : 'Content types';
const deprecationMessage = op.deprecated ? op.availability?.message : undefined;
const availabilityMessage = !op.deprecated ? op.availability?.message : undefined;
---

<div class="forge-operation-layout">
  <div class="forge-operation-intro">
    {
      op.deprecated ? (
        <Aside type="caution" title="Deprecated">
          <p>{deprecationMessage ?? 'This operation is deprecated.'}</p>
        </Aside>
      ) : null
    }
    {
      availabilityMessage ? (
        <Aside type="note" title={op.availability?.status.replaceAll('-', ' ')}>
          <p>{availabilityMessage}</p>
        </Aside>
      ) : null
    }
    {
      op.requireConfirmation ? (
        <Aside type="danger" title="Destructive operation">
          {op.requireConfirmation}
        </Aside>
      ) : null
    }
    {op.description.html ? <div class="forge-operation-desc" set:html={op.description.html} /> : null}
  </div>

  <aside class="forge-example-pane not-content" aria-label="Examples">
    <CodeSample
      targets={page.targets}
      selectedTarget={selectedTarget}
      snapshotId={page.snapshot.id}
      preserveVersionQuery={!page.snapshot.default}
      httpMethod={op.httpMethod}
      examples={op.examples ?? []}
      responses={op.responses}
    />
  </aside>

  <div class="forge-reference not-content">
    {
      view.fieldSections.map((section) => (
        <section class="forge-section">
          <h2 id={section.slug}>
            {section.title}
          </h2>
          {section.section === 'body' && op.requestBody ? (
            <div class="forge-request-body-meta">
              {op.requestBody.description?.html ? (
                <div class="forge-request-body-description" set:html={op.requestBody.description.html} />
              ) : null}
              <dl>
                <div>
                  <dt>Required</dt>
                  <dd>{op.requestBody.required ? 'Yes' : 'No'}</dd>
                </div>
                <div>
                  <dt>{requestContentTypeLabel}</dt>
                  <dd>
                    {requestMediaTypes.length > 0 ? (
                      <ul>
                        {requestMediaTypes.map((mediaType) => <li><code>{mediaType}</code></li>)}
                      </ul>
                    ) : (
                      'None declared'
                    )}
                  </dd>
                </div>
                {requestMediaTypes.length > 1 && view.requestRepresentation?.schema ? (
                  <div>
                    <dt>Schema shown for</dt>
                    <dd><code>{view.requestRepresentation.mediaType}</code></dd>
                  </div>
                ) : null}
              </dl>
            </div>
          ) : null}
          {section.nodes.length === 0 ? null : nodeCount(section.nodes) > DEFER_THRESHOLD ? (
            <SchemaSectionIsland
              server:defer
              entryId={page.entryId}
              snapshotId={page.snapshot.id}
              section={section.section}
              context="request"
            >
              <p slot="fallback" class="forge-coming-soon">
                Loading {section.title.toLowerCase()}…
              </p>
            </SchemaSectionIsland>
          ) : (
            <SchemaTree nodes={section.nodes} context="request" />
          )}
        </section>
      ))
    }

    {
      view.response ? (
        <section class="forge-section">
          <h2 id={view.responseSlug}>Returns</h2>
          {returnsSummary ? <p class="forge-returns-note">{returnsSummary}</p> : null}
          {showResponseSchemaSource && view.responseStatus && view.responseRepresentation ? (
            <p class="forge-returns-note">
              Schema shown for <code>{view.responseStatus.status}</code> ·{' '}
              <code>{view.responseRepresentation.mediaType}</code>
            </p>
          ) : null}
          {nodeCount(responseNodes) > DEFER_THRESHOLD ? (
            <SchemaSectionIsland
              server:defer
              entryId={page.entryId}
              snapshotId={page.snapshot.id}
              section="response"
              context="response"
            >
              <p slot="fallback" class="forge-coming-soon">
                Loading response fields…
              </p>
            </SchemaSectionIsland>
          ) : (
            <SchemaTree nodes={responseNodes} context="response" />
          )}
        </section>
      ) : null
    }
  </div>
</div>

<style>
  .forge-operation-layout {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  .forge-returns-note {
    margin: 0.5rem 0 0;
    color: var(--cf-muted-foreground);
    font-size: 0.875rem;
  }

  .forge-request-body-meta {
    margin-top: 0.75rem;
    color: var(--cf-muted-foreground);
    font-size: 0.875rem;
  }

  .forge-request-body-description :global(:first-child) {
    margin-top: 0;
  }

  .forge-request-body-meta dl {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }

  .forge-request-body-meta dl > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .forge-request-body-meta dt {
    color: var(--cf-foreground);
    font-weight: 600;
  }

  .forge-request-body-meta dd,
  .forge-request-body-meta ul {
    margin: 0;
  }

  .forge-request-body-meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0;
    list-style: none;
  }

  .forge-operation-intro {
    min-width: 0;
    max-width: 100%;
    max-width: 42rem;
    overflow-wrap: anywhere;
  }

  .forge-example-pane,
  .forge-reference {
    min-width: 0;
  }

  .forge-reference {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .forge-section {
    min-width: 0;
  }

  .forge-section :global(h2) {
    margin: 0;
    color: var(--cf-foreground);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .forge-section :global(.heading-anchor) {
    color: var(--cf-muted-foreground);
  }

  .forge-section :global(.heading-anchor:hover),
  .forge-section :global(.heading-anchor:focus-visible) {
    color: var(--cf-link);
  }

  .forge-coming-soon {
    color: var(--cf-muted-foreground);
    font-style: italic;
  }

  @media (min-width: 80rem) {
    .forge-operation-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 2rem;
      row-gap: 2.5rem;
    }

    .forge-operation-intro {
      grid-column: 1;
      grid-row: 1;
    }

    .forge-example-pane {
      --forge-example-height: 0px;
        margin-top: 0;
      position: sticky;
      top: min(
        calc(3.5rem + 1rem),
        calc(100vh - var(--forge-example-height) - 1rem)
      );
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }

    .forge-reference {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>
